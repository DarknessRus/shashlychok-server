
const express = require("express");

const app = express();
app.use(express.json({ limit: "50kb" }));

app.get("/", (req, res) => {
  res.send("🔥 Сервер заказов ШашлычОК работает!");
});

app.get("/health", (req, res) => {
  res.json({ status: "ok", service: "shashlychok-server" });
});

app.post("/api/order", async (req, res) => {
  const order = req.body;

  if (
    !order ||
    !Array.isArray(order.items) ||
    order.items.length === 0
  ) {
    return res.status(400).json({
      success: false,
      error: "Корзина пуста"
    });
  }

  const message = {
    type: "order",
    createdAt: new Date().toISOString(),
    customer: {
      phone: String(order.phone || "").slice(0, 40),
      address: String(order.address || "").slice(0, 300)
    },
    method: String(order.method || "Не указан").slice(0, 40),
    items: order.items.slice(0, 50).map(item => ({
      name: String(item.name || "").slice(0, 100),
      quantity: Math.max(
        1,
        Math.min(100, Number(item.quantity) || 1)
      ),
      price: Math.max(0, Number(item.price) || 0)
    })),
    note: String(order.note || "").slice(0, 500)
  };

  console.log("Получен заказ:", JSON.stringify(message));

  res.status(202).json({
    success: true,
    message: "Заказ принят сервером"
  });
});

const port = process.env.PORT || 3000;

app.listen(port, "0.0.0.0", () => {
  console.log(`ShashlychOK server listening on ${port}`);
});
